<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.SmartCampus" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <!-- Splash Screen theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Match the white background of your image -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <!-- Show newly generated SmartCampus app icon on the OS splash screen -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_app_logo</item>
        <!-- The theme to use after the splash screen is gone -->
        <item name="postSplashScreenTheme">@style/Theme.SmartCampus</item>
    </style>
</resources>