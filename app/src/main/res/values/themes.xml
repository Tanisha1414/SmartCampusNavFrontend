<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.SmartCampus" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <!-- Splash Screen theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Dark gradient matching app background -->
        <item name="windowSplashScreenBackground">#0F2027</item>
        <!-- Transparent icon to prevent logo duplicate display before Compose splash runs -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <!-- The theme to use after the splash screen is gone -->
        <item name="postSplashScreenTheme">@style/Theme.SmartCampus</item>
    </style>
</resources>