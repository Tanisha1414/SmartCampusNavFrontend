<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.SmartCampus" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <!-- Splash Screen theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Match the white background of your image -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <!-- Hide the default app icon (Gmail logo) by making it transparent -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <!-- The theme to use after the splash screen is gone -->
        <item name="postSplashScreenTheme">@style/Theme.SmartCampus</item>
    </style>
</resources>